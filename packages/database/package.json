{
  "name": "@aa-mold-hunters/database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma Database Client for Aamold Hunter",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "echo 'No build needed - TypeScript files exported directly'",
    "clean": "rm -rf .tsbuildinfo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx ./src/seed.ts",
    "db:studio": "prisma studio",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.6.0"
  },
  "devDependencies": {
    "@aa-mold-hunters/typescript-config": "workspace:*",
    "prisma": "6.6.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "publishConfig": {
    "access": "public"
  }
}
