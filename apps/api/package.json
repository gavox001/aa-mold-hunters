{
  "name": "@aa-mold-hunters/api",
  "version": "1.0.0",
  "private": true,
  "description": "Aamold Hunter API - NestJS Backend",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "dev": "cross-env API_PORT=3000 PORT=3000 nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aa-mold-hunters/database": "workspace:*",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.18",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@aa-mold-hunters/eslint-config": "workspace:*",
    "@aa-mold-hunters/typescript-config": "workspace:*",
    "@nestjs/cli": "11.0.7",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.1.18",
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.14.0",
    "@types/passport-jwt": "4.0.1",
    "cross-env": "^7.0.3",
    "eslint": "9.27.0",
    "jest": "29.7.0",
    "source-map-support": "0.5.21",
    "ts-jest": "29.3.2",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
